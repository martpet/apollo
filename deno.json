{
  "tasks": {
    "dev": "deno --permission-set --env-file --watch src/main.ts",
    "build": "deno -A tasks/build.ts",
    "deploy": "deno -A tasks/deploy.ts"
  },
  "permissions": {
    "default": {
      "net": true,
      "read": true,
      "write": true,
      "env": true
    }
  },
  "unstable": ["kv"],
  "imports": {
    "@/": "./src/",
    "@lib/serve": "./lib/serve/mod.ts",
    "@lib/utils": "./lib/utils/mod.ts",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^13.3.2",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "preact": "npm:preact@^10.29.8",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact"
  },
  "lint": {
    "rules": {
      "exclude": ["jsx-button-has-type"]
    }
  }
}
